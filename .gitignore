# Model weights. These are large (85 MB per best.pt, 368 MB per epoch
# checkpoint) and are distributed alongside the repo rather than inside it;
# see the README for where they go.
*.pt
*.pth
models/runs/
models/**/weights/
models/**/*.cache

# Auto-downloaded pretrained backbones, which ultralytics fetches on demand
yolo*.pt
mobile_sam.pt

# Generated output. Everything under results/ is reproducible by re-running
# the pipeline, and some of it is very large.
results/

# Source imagery and datasets
data/
yolo_images/
tomato_quarters/
poster_images/

# Images and figures
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.tif
*.svg
*.eps
*.pdf

# Data tables and geometry exports
*.csv
*.json
*.stl
*.xlsx

# Logs and notes
*.log
*.txt

# Must come after the *.txt rule above: in gitignore the last matching rule
# wins, so a negation placed earlier has no effect at all.
!requirements.txt

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Notebooks
.ipynb_checkpoints/
*.ipynb

# Environments and editors
.env
.venv
venv/
ENV/
env/
.vscode/
.idea/
*.swp
*.swo
*~

# Large binary data formats
*.h5
*.hdf5
*.npy
*.npz
*.pickle
*.pkl
*.mat

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Scratch
tmp/
temp/
*.tmp
.refactor_audit/
